.venv
data/
outputs/
checkpoints/
__pycache__/
*.egg-info/
.pytest_cache/
.ruff_cache/
results/raw/*
logs/

# Videos: regenerated by scripts/rerun_with_video.py and scripts/smoke_test.sh.
*.mp4
*.avi
*.webm
figures/videos/

# Data and model files. Per-episode results stay in results/raw/ (ignored above); the
# small CSVs of results/tables/ are tracked, every reported number comes from them.
*.parquet
*.npy
*.npz
*.pkl
*.pt
*.pth
*.safetensors
*.h5
*.hdf5

# Outputs of the analysis scripts, rebuilt from results/raw/ (scripts/analyze_*.py, validate_stats.py).
# GIFs of rollouts stay tracked for the README.
results/tables/*
!results/tables/.gitkeep
figures/*.png

# Tracked on purpose (Step 9): the per-episode data of the main grid (624 KB), from which every
# table and figure is rebuilt, and the figures shown in the README and the report.
!results/raw/main/
!results/raw/main/*.parquet
!figures/rq1.png
!figures/rq2_power.png
!figures/rq2_gap.png
!figures/rq3.png
